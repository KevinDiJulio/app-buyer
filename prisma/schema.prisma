generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Producto {
  id          Int      @id @default(autoincrement())
  nombre      String
  descripcion String
  precio      Float
  emoji       String
  stock       Int      @default(0)
  pedidos     Pedido[]
}

model Pedido {
  id          Int      @id @default(autoincrement())
  userId      String
  productoId  Int
  producto    Producto @relation(fields: [productoId], references: [id])
  cantidad    Int
  estado      String   @default("pendiente")
  pagoId      String?
  creadoEn   DateTime @default(now())
}
