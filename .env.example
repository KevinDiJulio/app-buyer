# Base de datos (Neon / Supabase / Railway)
DATABASE_URL=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# URL de la Payments App (para Etapa 3)
PAYMENTS_URL=

# API key compartido entre servicios para endpoints privados
# Generar con: openssl rand -hex 32
API_SECRET_KEY=

# Google Gemini API (para el chat con IA)
# Obtener en: aistudio.google.com
GEMINI_API_KEY=

# MercadoPago (obtener en mercadopago.com.ar/developers → Credenciales)
MP_ACCESS_TOKEN=          # server-side, nunca exponer al cliente
NEXT_PUBLIC_MP_PUBLIC_KEY= # client-side, prefix NEXT_PUBLIC_ es seguro para public keys
